# ==============================================================================
# Universal Production-Grade Kubernetes Cluster Configuration (cluster.env)
# Works across Cloud (AWS, Azure, GCP), On-Premise VMs, and Bare-Metal Servers
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cluster Identity & Version
# ------------------------------------------------------------------------------
CLUSTER_NAME="production-k8s"
K8S_VERSION="v1.32"                       # e.g., v1.31, v1.32, v1.36
CONTAINER_RUNTIME="containerd"           # containerd

# ------------------------------------------------------------------------------
# 2. Control Plane & Networking Configuration
# ------------------------------------------------------------------------------
# Primary Master Private IP or Load Balancer / VIP Endpoint
CONTROL_PLANE_ENDPOINT="10.0.12.235"       # e.g. Master Private IP or AWS NLB DNS / VIP
CONTROL_PLANE_PORT="6443"

# Pod and Service CIDRs (Carefully chosen to NOT collide with AWS VPC CIDRs)
# AWS VPC A: 10.10.0.0/16, AWS VPC B: 10.20.0.0/16
POD_CIDR="172.16.0.0/16"
SERVICE_CIDR="172.20.0.0/16"

# CNI Network Plugin & MTU Tuning
# For AWS Multi-Region VPC Peering / Transit Gateway, MTU 1440 prevents fragmentation
CNI_PLUGIN="calico"                       # Options: calico, cilium
CNI_MTU="1440"
NETWORK_INTERFACE="auto"                  # "auto" or specific NIC e.g. "eth0", "ens5", "enp0s1"

# High Availability (Multi-Master) Mode
HA_ENABLED="false"                        # Set to "true" if using 3+ master nodes with Keepalived/NLB
LOAD_BALANCER_VIP=""                      # Virtual IP if HA_ENABLED=true (for Keepalived on BareMetal/VM)

# ------------------------------------------------------------------------------
# 3. Security & TLS Certificate SANs
# Include any private IPs, public Elastic IPs, or DNS names that will access the API server
# ------------------------------------------------------------------------------
CERT_SANS="127.0.0.1,localhost,10.0.12.235,k8s.example.com"

# ------------------------------------------------------------------------------
# 4. Add-ons Configuration
# ------------------------------------------------------------------------------
INSTALL_METRICS_SERVER="true"             # Enables 'kubectl top nodes/pods' and HPA
INSTALL_LOCAL_STORAGE="true"              # Installs Rancher Local-Path dynamic StorageClass

# ------------------------------------------------------------------------------
# 5. Node Inventory (Used by deploy.sh for remote execution via SSH)
# Format: "hostname:ip:role:region"
# ------------------------------------------------------------------------------
# Example Multi-Region AWS Inventory:
# NODES=(
#   "master-us-east-1:10.0.12.235:control-plane:us-east-1"
#   "worker-us-east-1:10.10.1.20:worker:us-east-1"
#   "worker-us-west-2:10.20.1.30:worker:us-west-2"
#   "worker-eu-west-1:10.30.1.40:worker:eu-west-1"
# )
SSH_USER="ubuntu"                         # e.g., ubuntu, ec2-user, rocky, debian
SSH_KEY_PATH="~/.ssh/id_rsa"              # Private key for SSH authentication
